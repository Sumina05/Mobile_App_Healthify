# Copy to .env and fill in values. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=5000
# Bind address. 0.0.0.0 listens on every interface, which is what lets a phone
# on the same Wi-Fi reach the API. Use 127.0.0.1 to restrict it to this machine.
HOST=0.0.0.0

# Local MongoDB, or a MongoDB Atlas connection string (cloud database):
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthify
MONGODB_URI=mongodb://127.0.0.1:27017/healthify

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Comma-separated origins, or * during development
CORS_ORIGIN=*

# Seeded accounts, created on startup in development and by `npm run seed`.
# These defaults are demo credentials and are publicly known, so in
# production the startup seeder SKIPS unless both passwords are changed here.
ADMIN_EMAIL=admin@healthify.com
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Healthify Admin
DEMO_EMAIL=thakuri.sumina05@gmail.com
DEMO_PASSWORD=User12345
DEMO_NAME=Sumina Thakuri

# AI provider key (Anthropic). When set, analysis explanations and the
# chat assistant run on Claude; otherwise a deterministic fallback is used.
AI_API_KEY=

# Google Sign-In. Same client id as the Healthify web app (an OAuth client id
# is not a secret) and the Flutter app's native Google Sign-In config, so all
# three verify against one Google Cloud project. Leave empty to disable —
# POST /auth/google then returns a clear "not configured" error and the app
# hides the Google button.
GOOGLE_CLIENT_ID=

# Base URL of the Healthify WEB API, which owns the product catalogue and its
# EAN/UPC barcode mappings. Barcode lookups proxy there instead of duplicating
# the catalogue into this service's database, so the web app and the mobile
# app read the same product records. The web backend must be running for
# barcode scanning to resolve; if it is unreachable the mobile app falls back
# to the OCR ingredient-label scan.
WEB_API_BASE_URL=http://localhost:5001/api/v1

# Payment gateways (Nepal). Leave empty for simulated dev checkout.
# Khalti ePayment v2: https://docs.khalti.com  (KHALTI_BASE_URL defaults
# to the sandbox; switch to https://khalti.com/api/v2 in production)
KHALTI_SECRET_KEY=
# eSewa ePay v2: https://developer.esewa.com.np
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_CODE=EPAYTEST
# Defaults to the eSewa sandbox form endpoint; switch to
# https://epay.esewa.com.np/api/epay/main/v2/form in production.
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
PAYMENT_RETURN_URL=https://healthify.app/payment/return

# Externally reachable origin of THIS API. eSewa only accepts a signed form
# POST, so checkout hands the client a URL on this origin that serves a
# self-submitting form. Must be reachable from the payer's browser — set it
# to your tunnel/LAN/production host, not localhost, when testing on a phone.
PUBLIC_BASE_URL=http://localhost:5000
